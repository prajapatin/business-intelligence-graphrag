# LLM Provider: "openai", "groq", or "ollama"
LLM_PROVIDER=groq

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Groq
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.1-8b-instant

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Graph Backend: "networkx" or "neo4j"
GRAPH_BACKEND=networkx

# Neo4j (only if GRAPH_BACKEND=neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# API
API_HOST=0.0.0.0
API_PORT=8000

# Graph persistence
GRAPH_PERSIST_PATH=rag_data/knowledge_graph.gpickle
